+RCT_EXPORT_METHOD(chooseAudioRoute:(NSString *)audioRoute
+                  resolver:(RCTPromiseResolveBlock)resolve
+                  rejecter:(RCTPromiseRejectBlock)reject)
+{
+    NSLog(@"RNInCallManager.chooseAudioRoute(): user choose audioDevice = %@", audioRoute);
+
+    if ([audioRoute isEqualToString:@"SPEAKER_PHONE"]) {
+        [self setSpeakerphoneOn:YES];
+    } else if ([audioRoute isEqualToString:@"EARPIECE"]) {
+        [self setSpeakerphoneOn:NO];
+    } else if ([audioRoute isEqualToString:@"BLUETOOTH"]) {
+        @try {
+            [self audioSessionSetCategory:_incallAudioCategory
+                                  options:[self incallAudioCategoryOptions]
+                               callerMemo:NSStringFromSelector(_cmd)];
+            [self audioSessionSetMode:_incallAudioMode
+                            callerMemo:NSStringFromSelector(_cmd)];
+            [_audioSession overrideOutputAudioPort:AVAudioSessionPortOverrideNone error:nil];
+            [self audioSessionSetActive:YES
+                                options:0
+                             callerMemo:NSStringFromSelector(_cmd)];
+        } @catch (NSException *e) {
+            NSLog(@"RNInCallManager.chooseAudioRoute(): caught error = %@", e.reason);
+            reject(@"error_code", @"chooseAudioRoute() failed", RCTErrorWithMessage(e.reason));
+            return;
+        }
+    } else if ([audioRoute isEqualToString:@"WIRED_HEADSET"]) {
+        [_audioSession overrideOutputAudioPort:AVAudioSessionPortOverrideNone error:nil];
+    }
+
+    [self sendAudioDeviceChangedEvent];
+    resolve([self getAudioDeviceStatusMap]);
+}
