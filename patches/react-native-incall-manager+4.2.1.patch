+- (AVAudioSessionCategoryOptions)incallAudioCategoryOptions
+{
+    // DefaultToSpeaker: PlayAndRecord/VoiceChat otherwise routes to the earpiece.
+    // Wired / Bluetooth still take priority when connected.
+    AVAudioSessionCategoryOptions options =
+        AVAudioSessionCategoryOptionAllowBluetooth |
+        AVAudioSessionCategoryOptionDefaultToSpeaker;
+    if (@available(iOS 10.0, *)) {
+        options = options | AVAudioSessionCategoryOptionAllowBluetoothA2DP;
+    }
+    return options;
+}
+
+- (BOOL)isBluetoothRouteAvailable
+{
+    NSArray<NSString *> *bluetoothPortTypes = @[
+        AVAudioSessionPortBluetoothHFP,
+        AVAudioSessionPortBluetoothA2DP,
+        AVAudioSessionPortBluetoothLE,
+    ];
+
+    if ([self checkAudioRoute:bluetoothPortTypes routeType:@"output"]
+            || [self checkAudioRoute:bluetoothPortTypes routeType:@"input"]) {
+        return YES;
+    }
+
+    NSArray<AVAudioSessionPortDescription *> *availableInputs = [_audioSession availableInputs];
+    for (AVAudioSessionPortDescription *portDescription in availableInputs) {
+        if ([bluetoothPortTypes containsObject:portDescription.portType]) {
+            return YES;
+        }
+    }
+    return NO;
+}
+
+- (NSString *)selectedAudioDeviceName
+{
+    if ([self checkAudioRoute:@[AVAudioSessionPortBuiltInSpeaker] routeType:@"output"]) {
+        return @"SPEAKER_PHONE";
+    }
+    if ([self isBluetoothRouteAvailable]) {
+        return @"BLUETOOTH";
+    }
+    if ([self isWiredHeadsetPluggedIn]) {
+        return @"WIRED_HEADSET";
+    }
+    return @"EARPIECE";
+}
+
+- (NSDictionary *)getAudioDeviceStatusMap
+{
+    NSMutableArray<NSString *> *availableAudioDevices = [NSMutableArray arrayWithObjects:@"SPEAKER_PHONE", @"EARPIECE", nil];
+    if ([self isBluetoothRouteAvailable]) {
+        [availableAudioDevices addObject:@"BLUETOOTH"];
+    }
+    if ([self isWiredHeadsetPluggedIn]) {
+        [availableAudioDevices addObject:@"WIRED_HEADSET"];
+    }
+
+    NSData *jsonData = [NSJSONSerialization dataWithJSONObject:availableAudioDevices options:0 error:nil];
+    NSString *availableAudioDeviceList = [[NSString alloc] initWithData:jsonData encoding:NSUTF8StringEncoding];
+
+    return @{
+        @"availableAudioDeviceList": availableAudioDeviceList ?: @"[]",
+        @"selectedAudioDevice": [self selectedAudioDeviceName],
+    };
+}
+
+- (void)sendAudioDeviceChangedEvent
+{
+    [self sendEventWithName:@"onAudioDeviceChanged"
+                       body:[self getAudioDeviceStatusMap]];
+}
