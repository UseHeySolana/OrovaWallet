<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <!-- Minimized Button (Bubble style) -->
    <ImageView
        android:id="@+id/pip_main_button"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@drawable/pip_bubble_background"
        android:src="@drawable/ic_notification"
        android:scaleType="centerInside"
        android:padding="14dp"
        android:elevation="12dp"
        android:visibility="gone" />

    <!-- Expanded PiP View -->
    <LinearLayout
        android:id="@+id/pip_main_content"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/pip_overlay_background"
        android:elevation="12dp"
        android:padding="12dp"
        android:visibility="visible">

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@drawable/pip_handle_background"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Title or Status -->
        <TextView
            android:id="@+id/pip_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Assistant Active"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"/>

        <!-- Control Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal">

            <!-- Assistant -->
            <ImageView
                android:id="@+id/pip_assistant_button"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/pip_button_primary"
                android:src="@drawable/ic_notification"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Minimize -->
            <ImageView
                android:id="@+id/pip_minimize_button"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/pip_button_secondary"
                android:src="@android:drawable/ic_menu_revert"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Close -->
            <ImageView
                android:id="@+id/pip_close_button"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/pip_button_accent"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout> 