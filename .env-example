
# EXPO_PUBLIC_GA_KEY=""

# EXPO_PUBLIC_NETWORK=""

# EXPO_PUBLIC_DEEPGRAM=""

# EXPO_PUBLIC_HELIUS_API=""

# Firebase client config is google-services.json (see app.json android.googleServicesFile).
# FCM server credentials live in EAS (eas credentials → Android → FCM V1), not in .env.

# Backend API base URL (must end with /api). Use your machine's IP when testing on device.
# Example: http://192.168.1.100:8000/api  (match the host/port where Laravel runs)
# Enable QVAC P2P compute sharing (provider register + delegate fallback).
# EXPO_PUBLIC_QVAC_P2P_ENABLED=true

# EXPO_PUBLIC_APIFY_KEY=""

# EXPO_PUBLIC_OPENAI_API_KEY=""

# Voice assistant backend: openai (public cloud Realtime) or qvac (private on-device Whisper + Llama + TTS).
# Private mode downloads ~1 GB of models on first use. Users pick during AI onboarding.
# EXPO_PUBLIC_VOICE_BACKEND=openai

# Optional override for backend token metadata cache.
# Defaults to EXPO_PUBLIC_API_URL when unset.
# EXPO_PUBLIC_TOKEN_CACHE_URL=""

# PajCash Ramp (onramp / offramp) — business API key from paj.cash
# EXPO_PUBLIC_PAJCASH_API_KEY=""
# EXPO_PUBLIC_PAJCASH_ENV="staging"
# EXPO_PUBLIC_PAJCASH_WEBHOOK_URL=""
# Optional fallback only when token search cannot resolve USDC on the active network.
# EXPO_PUBLIC_PAJCASH_USDC_MINT=""