# Copy to `.env` and fill in values for local / EAS builds.
# OpenAI text/voice is proxied via the Laravel backend (OPENAI_API_KEY there). No client OpenAI key.

# --- Core ---
# Backend API base URL (must end with /api). Use your machine's LAN IP on a physical device.
# Example: http://192.168.1.100:8000/api
# EXPO_PUBLIC_API_URL=""

# Solana cluster / RPC base used by wallet settings
# EXPO_PUBLIC_NETWORK=""

# Helius API key (balances, history, DAS)
# EXPO_PUBLIC_HELIUS_API=""

# Optional: "production" gates some client behavior (see app/index.tsx)
# EXPO_PUBLIC_ENV=""

# --- AI / Brain ---
# Optional Gemini path (legacy / experimental voiceinfra)
# EXPO_PUBLIC_GA_KEY=""
# EXPO_PUBLIC_DEEPGRAM=""

# Brain digest suggestions via backend LLM
# EXPO_PUBLIC_BRAIN_SUGGESTIONS_LLM="false"

# Require enrolled speaker + VerifiedVoiceStream before AI commands (default: off)
# EXPO_PUBLIC_VOICE_VERIFICATION_ENABLED="false"

# --- Tokens / Jupiter ---
# EXPO_PUBLIC_JUP_API_KEY=""
# Optional override for backend token metadata cache (defaults to EXPO_PUBLIC_API_URL)
# EXPO_PUBLIC_TOKEN_CACHE_URL=""
# EXPO_PUBLIC_VERIFIED_TOKENS_URL=""
# EXPO_PUBLIC_JUP_REFERRAL_ACCOUNT=""
# EXPO_PUBLIC_JUP_REFERRAL_FEE_BPS="0"

# --- Partners ---
# EXPO_PUBLIC_PAJCASH_API_KEY=""
# EXPO_PUBLIC_PAJCASH_ENV="staging"
# EXPO_PUBLIC_PAJCASH_WEBHOOK_URL=""
# Optional fallback when token search cannot resolve USDC on the active network
# EXPO_PUBLIC_PAJCASH_USDC_MINT=""
# EXPO_PUBLIC_PAJCASH_ONRAMP_USDC_FEE="0"
# EXPO_PUBLIC_PAJCASH_OFFRAMP_USDC_FEE="0"

# EXPO_PUBLIC_AIR_BILLS=""
# EXPO_PUBLIC_SCRAPER_API_KEY=""
# EXPO_PUBLIC_CROSSMINT=""
# EXPO_PUBLIC_APIFY_KEY=""
# EXPO_PUBLIC_JUMIA_USDC_TREASURY=""

# MagicBlock private payments
# EXPO_PUBLIC_MAGICBLOCK_API="https://payments.magicblock.app"
# EXPO_PUBLIC_MAGICBLOCK_EPHEMERAL_RPC=""
# EXPO_PUBLIC_MAGICBLOCK_EPHEMERAL_DEVNET_RPC=""

# --- Google Sign-In / Drive backup ---
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=""
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""

# Firebase client config is google-services.json (see app.json android.googleServicesFile).
# FCM server credentials live in EAS (eas credentials → Android → FCM V1), not in .env.
