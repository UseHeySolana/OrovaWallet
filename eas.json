{
  "build": {
    "dapp-store": {
      "env": {
        "APP_VARIANT": "solana-mobile"
      },
      "channel": "production",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      }
    },
    "test": {
      "env": {
        "APP_VARIANT": "play"
      },
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "test"
    },
    "production": {
      "env": {
        "APP_VARIANT": "play"
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease",
        "withoutCredentials": false
      },
      "developmentClient": false,
      "channel": "production"
    }
  }
}
