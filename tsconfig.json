{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "strict": true,
    "paths": {
      "@/*": [
        "./*",
        "./context/*",
        "./misc/*",
        "./libs/*",
        "./utils/*",
        "./assets/*",
        "./components/*",
        "./app/*",
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "index.ts"
, "libs/tools/heysolanaapp/endstream.tool.ts"  ]
}