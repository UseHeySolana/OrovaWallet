{
  "app": {
    "name": "Smart TODO",
    "version": "1.0.0",
    "description": "AI-powered task management with smart event detection and automatic calendar integration",
    "category": "Tools",
    "tags": ["Tools", "Productivity", "AI", "Task Management", "Smart Detection"],
    "is_active": true,
    "is_featured": true,
    "is_new": true,
    "ratings": 4.9,
    "short_description": "AI-powered task management with smart event detection!",
    "long_description": "Create, manage, and organize your tasks with AI-powered smart detection. The system automatically identifies events and creates calendar entries, while providing comprehensive task management with priorities, categories, and due dates. Perfect for busy professionals who want to stay organized and never miss important events.",
    
    "brand_colors": {
      "primary": "#6366F1",
      "secondary": "#8B5CF6",
      "accent": "#EC4899",
      "success": "#10B981",
      "warning": "#F59E0B",
      "error": "#EF4444"
    },
    
    "urls": {
      "main": "https://heysolana.com/todo",
      "api": "https://heysolana.com/api/todo",
      "documentation": "https://heysolana.com/docs/todo",
      "support": "https://heysolana.com/support"
    },
    
    "assets": {
      "icon": "require('@/assets/apps/todo/logo.webp')",
      "banner": "require('@/assets/apps/todo/banner.webp')",
      "description_images": [
        "require('@/assets/apps/todo/des1.webp')",
        "require('@/assets/apps/todo/des2.webp')",
        "require('@/assets/apps/todo/des3.webp')",
        "require('@/assets/apps/todo/des4.webp')"
      ]
    },
    
    "features": {
      "ai_powered": true,
      "voice_commands": true,
      "natural_language": true,
      "smart_event_detection": true,
      "auto_calendar_integration": true,
      "priority_management": true,
      "category_organization": true,
      "due_date_tracking": true,
      "subtask_support": true,
      "bulk_operations": true,
      "search_and_filter": true,
      "statistics_and_analytics": true,
      "offline_support": true,
      "sync_across_devices": false,
      "notifications": true,
      "reminders": true
    },
    
    "tools": [
      {
        "name": "todo_management",
        "display_name": "Task Management",
        "description": "Core task management functionality with AI-powered features",
        "category": "Core",
        "is_required": true,
        "params": [
          {
            "name": "task_title",
            "type": "string",
            "display_name": "Task Title",
            "description": "Title or description of the task",
            "placeholder": "Buy groceries for dinner",
            "validation": {
              "required": true,
              "min_length": 1,
              "max_length": 200
            }
          },
          {
            "name": "priority_level",
            "type": "select",
            "display_name": "Priority Level",
            "description": "How important this task is",
            "default_value": "medium",
            "options": [
              {
                "value": "low",
                "name": "Low Priority",
                "description": "Not urgent, can be done later"
              },
              {
                "value": "medium",
                "name": "Medium Priority",
                "description": "Important but not urgent"
              },
              {
                "value": "high",
                "name": "High Priority",
                "description": "Important and time-sensitive"
              },
              {
                "value": "urgent",
                "name": "Urgent Priority",
                "description": "Critical, must be done immediately"
              }
            ]
          },
          {
            "name": "task_category",
            "type": "select",
            "display_name": "Task Category",
            "description": "Organize tasks by category",
            "default_value": "other",
            "options": [
              {
                "value": "personal",
                "name": "Personal",
                "description": "Personal tasks and errands"
              },
              {
                "value": "work",
                "name": "Work",
                "description": "Work-related tasks and projects"
              },
              {
                "value": "shopping",
                "name": "Shopping",
                "description": "Shopping lists and purchases"
              },
              {
                "value": "health",
                "name": "Health",
                "description": "Health and fitness related"
              },
              {
                "value": "finance",
                "name": "Finance",
                "description": "Financial tasks and bills"
              },
              {
                "value": "other",
                "name": "Other",
                "description": "Miscellaneous tasks"
              }
            ]
          },
          {
            "name": "due_date",
            "type": "string",
            "display_name": "Due Date",
            "description": "When the task should be completed",
            "placeholder": "tomorrow",
            "examples": [
              "today",
              "tomorrow",
              "next week",
              "Friday",
              "March 15th",
              "in 2 hours"
            ],
            "validation": {
              "required": false
            }
          },
          {
            "name": "description",
            "type": "string",
            "display_name": "Description",
            "description": "Additional details about the task",
            "placeholder": "Need to buy milk, bread, and eggs",
            "validation": {
              "required": false,
              "max_length": 1000
            }
          },
          {
            "name": "tags",
            "type": "array",
            "display_name": "Tags",
            "description": "Custom tags to organize tasks",
            "placeholder": "shopping, groceries, dinner",
            "validation": {
              "required": false,
              "max_items": 10
            }
          }
        ],
        "actions": [
          {
            "name": "create",
            "type": "store_action",
            "description": "Create new TODO item in Zustand store",
            "store": "useTodoStore",
            "method": "addTodo"
          },
          {
            "name": "update",
            "type": "store_action",
            "description": "Update existing TODO item",
            "store": "useTodoStore",
            "method": "updateTodo"
          },
          {
            "name": "delete",
            "type": "store_action",
            "description": "Delete TODO item",
            "store": "useTodoStore",
            "method": "deleteTodo"
          }
        ]
      },
      
      {
        "name": "smart_event_detection",
        "display_name": "Smart Event Detection",
        "description": "AI-powered detection of events and automatic calendar integration",
        "category": "AI",
        "is_required": false,
        "params": [
          {
            "name": "auto_calendar",
            "type": "select",
            "display_name": "Auto Calendar Creation",
            "description": "Automatically create calendar events for detected events",
            "default_value": "enabled",
            "options": [
              {
                "value": "enabled",
                "name": "Auto-create calendar events",
                "description": "Automatically create calendar events when events are detected"
              },
              {
                "value": "disabled",
                "name": "Manual calendar creation only",
                "description": "Only create calendar events when explicitly requested"
              }
            ]
          },
          {
            "name": "event_notifications",
            "type": "select",
            "display_name": "Event Notifications",
            "description": "Enable notifications for calendar events",
            "default_value": "enabled",
            "options": [
              {
                "value": "enabled",
                "name": "Enable event notifications",
                "description": "Send notifications for calendar events"
              },
              {
                "value": "disabled",
                "name": "Disable event notifications",
                "description": "No notifications for calendar events"
              }
            ]
          },
          {
            "name": "detection_sensitivity",
            "type": "select",
            "display_name": "Detection Sensitivity",
            "description": "How sensitive the AI is to detecting events",
            "default_value": "medium",
            "options": [
              {
                "value": "low",
                "name": "Low Sensitivity",
                "description": "Only detect obvious events (meetings, appointments)"
              },
              {
                "value": "medium",
                "name": "Medium Sensitivity",
                "description": "Detect most events with time and location"
              },
              {
                "value": "high",
                "name": "High Sensitivity",
                "description": "Detect any task that might be time-sensitive"
              }
            ]
          }
        ],
        "actions": [
          {
            "name": "detect_event",
            "type": "ai_function",
            "description": "Analyze task text for event indicators",
            "function": "detectEventFromText",
            "patterns": [
              "time_indicators",
              "event_keywords",
              "location_indicators",
              "duration_indicators"
            ]
          },
          {
            "name": "create_calendar_event",
            "type": "api_call",
            "description": "Create calendar event for detected events",
            "endpoint": "Google Calendar API",
            "method": "POST"
          }
        ]
      },
      
      {
        "name": "task_operations",
        "display_name": "Task Operations",
        "description": "Advanced task management operations",
        "category": "Advanced",
        "is_required": false,
        "params": [
          {
            "name": "operation_type",
            "type": "select",
            "display_name": "Operation Type",
            "description": "Type of operation to perform",
            "default_value": "list",
            "options": [
              {
                "value": "list",
                "name": "List Tasks",
                "description": "Show all tasks with optional filtering"
              },
              {
                "value": "search",
                "name": "Search Tasks",
                "description": "Search tasks by text content"
              },
              {
                "value": "toggle",
                "name": "Toggle Completion",
                "description": "Mark task as complete or incomplete"
              },
              {
                "value": "subtask",
                "name": "Add Subtask",
                "description": "Add a subtask to an existing task"
              },
              {
                "value": "bulk",
                "name": "Bulk Operations",
                "description": "Perform operations on multiple tasks"
              }
            ]
          },
          {
            "name": "filter_criteria",
            "type": "object",
            "display_name": "Filter Criteria",
            "description": "Criteria to filter tasks by",
            "properties": {
              "status": {
                "type": "select",
                "options": [
                  { "value": "all", "name": "All Tasks" },
                  { "value": "pending", "name": "Pending Only" },
                  { "value": "completed", "name": "Completed Only" }
                ]
              },
              "priority": {
                "type": "select",
                "options": [
                  { "value": "all", "name": "All Priorities" },
                  { "value": "low", "name": "Low Priority" },
                  { "value": "medium", "name": "Medium Priority" },
                  { "value": "high", "name": "High Priority" },
                  { "value": "urgent", "name": "Urgent Priority" }
                ]
              },
              "category": {
                "type": "select",
                "options": [
                  { "value": "all", "name": "All Categories" },
                  { "value": "personal", "name": "Personal" },
                  { "value": "work", "name": "Work" },
                  { "value": "shopping", "name": "Shopping" },
                  { "value": "health", "name": "Health" },
                  { "value": "finance", "name": "Finance" },
                  { "value": "other", "name": "Other" }
                ]
              }
            }
          }
        ],
        "actions": [
          {
            "name": "list_tasks",
            "type": "store_action",
            "description": "List tasks with filtering",
            "store": "useTodoStore",
            "method": "getFilteredTodos"
          },
          {
            "name": "search_tasks",
            "type": "store_action",
            "description": "Search tasks by text",
            "store": "useTodoStore",
            "method": "searchTodos"
          },
          {
            "name": "toggle_completion",
            "type": "store_action",
            "description": "Toggle task completion status",
            "store": "useTodoStore",
            "method": "toggleComplete"
          }
        ]
      }
    ],
    
    "ai_integration": {
      "supported_commands": [
        "Create a task to buy groceries tomorrow",
        "Add meeting with John at 2 PM to my todo list",
        "Mark the shopping task as complete",
        "Show me all pending work tasks",
        "Search for tasks containing 'meeting'",
        "Create a subtask for the project planning",
        "What tasks are due today?",
        "Show my todo statistics",
        "Bulk complete all shopping tasks"
      ],
      "natural_language_processing": {
        "task_creation": true,
        "event_detection": true,
        "date_parsing": true,
        "priority_assignment": true,
        "category_classification": true,
        "smart_suggestions": true
      },
      "context_awareness": {
        "task_relationships": true,
        "due_date_tracking": true,
        "priority_management": true,
        "category_organization": true,
        "event_calendar_sync": true
      },
      "learning_capabilities": {
        "user_preferences": true,
        "task_patterns": true,
        "priority_learning": true,
        "category_suggestions": true
      }
    },
    
    "event_detection": {
      "patterns": {
        "time_indicators": [
          "tomorrow", "today", "next week", "next month", "this weekend",
          "morning", "afternoon", "evening", "night", "tonight",
          "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday",
          "am", "pm", "o'clock", "hour", "minute"
        ],
        "event_keywords": [
          "meeting", "appointment", "call", "conference", "presentation",
          "interview", "session", "workshop", "training", "seminar",
          "party", "celebration", "dinner", "lunch", "breakfast",
          "doctor", "dentist", "therapy", "consultation", "checkup",
          "flight", "trip", "travel", "vacation", "holiday"
        ],
        "location_indicators": [
          "at", "in", "on", "room", "office", "building", "center",
          "hospital", "clinic", "restaurant", "cafe", "hotel", "airport"
        ],
        "duration_indicators": [
          "for", "duration", "minutes", "hours", "days", "weeks"
        ]
      },
      "detection_algorithm": {
        "text_analysis": true,
        "pattern_matching": true,
        "context_understanding": true,
        "confidence_scoring": true,
        "false_positive_reduction": true
      },
      "calendar_integration": {
        "auto_creation": true,
        "event_sync": true,
        "reminder_setting": true,
        "attendee_management": true,
        "location_mapping": true
      }
    },
    
    "permissions": {
      "required": [
        "storage.read",
        "storage.write"
      ],
      "optional": [
        "calendar.readonly",
        "calendar.events",
        "notifications"
      ],
      "description": "This app needs access to local storage for task management and optional calendar access for event creation."
    },
    
    "privacy": {
      "data_collection": "minimal",
      "data_storage": "local_only",
      "third_party_sharing": "none",
      "encryption": "standard",
      "compliance": ["GDPR", "CCPA"],
      "data_retention": "user_controlled"
    },
    
    "support": {
      "documentation": "https://heysolana.com/docs/todo",
      "tutorial": "To use Smart TODO, simply tell the AI what you need to do. For example, say 'Create a task to buy groceries tomorrow' or 'Add meeting with John at 2 PM to my todo list'. The AI will automatically detect if it's an event and create a calendar entry if you have Google Calendar integration set up.",
      "contact": {
        "email": "support@heysolana.com",
        "website": "https://heysolana.com/support",
        "response_time": "24 hours"
      }
    },
    
    "updates": {
      "last_updated": "2024-01-15",
      "version_history": [
        {
          "version": "1.0.0",
          "date": "2024-01-15",
          "changes": [
            "Initial release",
            "AI-powered task management",
            "Smart event detection",
            "Google Calendar integration",
            "Priority and category management",
            "Subtask support",
            "Bulk operations"
          ]
        }
      ],
      "roadmap": [
        "Multi-device sync",
        "Team collaboration",
